# Hanzo Calendar (cal.hanzo.ai) — white-label + secret env surface.
#
# This mirrors deploy/hanzo/configmap.yaml (non-secret) + secret.template.yaml
# (secret) for local/dev runs and as human-readable documentation of every
# value cal.hanzo.ai needs. In k8s the non-secret block lives in the `cal-env`
# ConfigMap and the secret block in the `cal-secrets` Secret (KMS-populated).
#
# cal.com's branding is 100% env-driven (packages/lib/constants.ts): setting the
# NEXT_PUBLIC_* values below IS the white-label. No source rewrite of brand
# strings is required.
#
# ── URLs ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WEBAPP_URL=https://cal.hanzo.ai
NEXT_PUBLIC_WEBSITE_URL=https://cal.hanzo.ai
NEXTAUTH_URL=https://cal.hanzo.ai

# ── Brand ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Hanzo Calendar
NEXT_PUBLIC_COMPANY_NAME=Hanzo Industries, Inc.
NEXT_PUBLIC_SUPPORT_MAIL_ADDRESS=support@hanzo.ai
NEXT_PUBLIC_SENDER_ID=Hanzo
NEXT_PUBLIC_SENDGRID_SENDER_NAME=Hanzo Calendar
EMAIL_FROM=notifications@hanzo.ai
EMAIL_FROM_NAME=Hanzo Calendar

# ── Operational ──────────────────────────────────────────────────────────────
CALCOM_TELEMETRY_DISABLED=1
ORGANIZATIONS_ENABLED=false
NEXT_PUBLIC_DISABLE_SIGNUP=true

# ── Secrets (KMS in prod — DO NOT fill real values in git) ───────────────────
# Postgres (see checklist). cal.com runs prisma migrate deploy on boot.
DATABASE_URL=
DATABASE_DIRECT_URL=
# openssl rand -base64 32
NEXTAUTH_SECRET=
# EXACTLY 32 chars: openssl rand -base64 24
CALENDSO_ENCRYPTION_KEY=
# Google Cloud OAuth "Web application" client JSON, single line.
# Redirect: https://cal.hanzo.ai/api/integrations/googlecalendar/callback
GOOGLE_API_CREDENTIALS=
# SMTP mailbox for booking email.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# ── Office 365 / Microsoft Graph calendar ────────────────────────────────────
# NOT env-configured. Set the MS Graph client id/secret in the running app:
#   Settings > Admin > Apps > Microsoft 365 Calendar
# stored encrypted in the DB. Azure redirect URI:
#   https://cal.hanzo.ai/api/integrations/office365calendar/callback
